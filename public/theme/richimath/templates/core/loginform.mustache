{{!
    @template core/loginform

    Moodle template for the login page.

    Richi Math copy, rebuilt on the 5.3 core template (MIG-21, 2026-10-09)
    with a three-way merge, never by pasting the 4.3 copy. What differs from
    core: the Crystalline Academic Glass layout (top bar, two-pane card, glyph
    field — docs/product/ux-pro-login-and-exam-flow.md), the shorter username
    label, the form posting to the clean /login (render_login()), and our own
    show-password button, shown only while core's loginpasswordtoggle is on.
    Everything else follows 5.3: error and info markup, showloginform, the
    OAuth2 client notice, auth instructions and the focus script.

    Context variables required for this template:
    * autofocusform: Auto focus on form ?,
    * canloginasguest - Is guest login allowed?,
    * canloginbyemail - Is login by email allowed?,
    * cansignup - Signup allowed?,
    * showloginform - Hide the standard login form if it not necessary (only OAuth2 for example)
    * error - Any errors in the form?,
    * errortitle - Optional bold heading shown above the error message (credential failures only),
    * hasauthinstructions - Flag, set to true when auth_instructions is configured,
    * info - Info notification to display,
    * forgotpasswordurl - Forgot password url,
    * hasidentityproviders - Flag, set to true to hide identity providers,
    * identityproviders - List of identity providers,
    * instructions - Instructions,
    * loginurl - Login url,
    * signupurl - Signup url,
    * logourl - Flag, logo url,
    * sitename - Name of site.,
    * logintoken - Random token to protect login request.,
    * maintenance - Maintenance message,
    * hasoauth2client - Flag, set when this login form is part of an OAuth2 authorization flow,
    * client - The requesting OAuth2 client, if hasoauth2client is true
      * name - The client's name,
      * description - The client's description, as formatted HTML.

    Example context (json):
    {
        "autofocusform": false,
        "canloginasguest": "1",
        "canloginbyemail": false,
        "cansignup": true,
        "showloginform": true,
        "error": "",
        "errortitle": "",
        "hasauthinstructions": false,
        "info": "",
        "forgotpasswordurl": "http://localhost/stable_master/login/forgot_password.php",
        "hasidentityproviders": false,
        "identityproviders": [],
        "instructions": "For full access to this site, you first need to create an account.",
        "loginurl": "http://localhost/stable_master/login/index.php",
        "signupurl": "http://localhost/stable_master/login/signup.php",
        "logourl": false,
        "sitename": "Beer & Chips",
        "logintoken": "randomstring",
        "maintenance": "For full access to this site, you need to login in as an admin.",
        "languagemenu": "Choose language",
        "togglepassword": true,
        "smallscreensonly": true,
        "hasoauth2client": false
    }
}}

<div class="loginform richimath-loginform">
    {{> theme_richimath/local/mathfield }}

    {{! Crystalline Academic Glass (docs/ux_pro): a top identity bar, a two-pane
        card — brand on the left, credentials on the right — and a credits line. }}
    <header class="rm-login-topbar">
        <div class="rm-login-brand">
            {{#pix}} loginlogo, theme_richimath {{/pix}}
            <span class="rm-login-brand-text">
                <span class="rm-login-brand-name">{{#str}} brandname, theme_richimath {{/str}}</span>
                <span class="rm-login-brand-sub">{{#str}} logincampus, theme_richimath {{/str}}</span>
            </span>
        </div>
        <div class="rm-login-topbar-meta">
            <span class="rm-login-chip rm-login-chip-secure">
                <i class="fa fa-lock" aria-hidden="true"></i>{{#str}} loginsecure, theme_richimath {{/str}}
            </span>
            {{#languagemenu}}
                <div class="login-languagemenu rm-login-lang">
                    {{>core/action_menu}}
                </div>
            {{/languagemenu}}
        </div>
    </header>

    <div class="rm-login-card">
        <section class="rm-login-hero">
            <span class="rm-login-chip rm-login-chip-edition">
                <span class="rm-login-chip-dot" aria-hidden="true"></span>{{#str}} loginportal, theme_richimath {{/str}}
            </span>
            <h1 class="login-heading richimath-login-heading">{{#str}} welcomeheading, theme_richimath {{/str}}</h1>
            <p class="rm-login-lead">{{#str}} loginlead, theme_richimath {{/str}}</p>
            <div class="rm-login-logocard">
                {{#pix}} loginlogo, theme_richimath {{/pix}}
                <span class="rm-login-logocard-text">
                    <span class="rm-login-logocard-name">{{{sitename}}}</span>
                    <span class="rm-login-logocard-sub">{{#str}} welcometagline, theme_richimath {{/str}}</span>
                </span>
            </div>
            <div class="rm-login-hero-foot">
                <span class="rm-login-status"><span class="rm-login-status-dot" aria-hidden="true"></span>{{#str}} loginonline, theme_richimath {{/str}}</span>
                <span class="rm-login-mono">Moodle LMS</span>
            </div>
        </section>

        <section class="rm-login-panel">
            <h2 class="rm-login-panel-title">{{#str}} login {{/str}}</h2>
            <p class="rm-login-panel-sub">{{#str}} loginpanelsub, theme_richimath {{/str}}</p>

            {{#hasoauth2client}}
                <h3 class="login-heading rm-login-subheading">{{#str}}oauth2:confirmscopes:clientaccesstitle, moodle, {
                    "clientname": {{#quote}}{{client.name}}{{/quote}},
                    "clientdescription": {{#quote}}{{client.description}}{{/quote}},
                    "sitename": {{#quote}}{{sitename}}{{/quote}}
                }{{/str}}</h3>
                {{> core/oauth2/client_description}}
            {{/hasoauth2client}}

            {{#maintenance}}
                <div class="alert alert-danger login-maintenance">
                    {{{maintenance}}}
                </div>
            {{/maintenance}}
            {{! 5.3 markup: the message itself carries the id, and the script at
                the bottom moves focus to the username field. }}
            {{#error}}
                <div class="alert alert-danger" id="loginerrormessage" role="alert">
                    {{#errortitle}}<strong class="d-block mb-1">{{errortitle}}</strong>{{/errortitle}}
                    {{error}}
                </div>
            {{/error}}
            {{#info}}
                <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
            {{/info}}

            {{! render_login() in this theme's renderer replaces loginurl with
                the address from local/richimath/routes.php, so a failed login
                re-renders on the clean URL — and falls back to the plain one
                when the web server is not serving the clean addresses. }}
            {{#showloginform}}
            <form class="login-form" action="{{loginurl}}" method="post" id="login">
                <input id="anchor" type="hidden" name="anchor" value="">
                <script>document.getElementById('anchor').value = location.hash;</script>
                <input type="hidden" name="logintoken" value="{{logintoken}}">
                <div class="login-form-username mb-3">
                    <label for="username" class="richimath-field-label">
                        {{^canloginbyemail}}
                            {{#str}} loginusername, theme_richimath {{/str}}
                        {{/canloginbyemail}}
                        {{#canloginbyemail}}
                            {{#str}} usernameemail {{/str}}
                        {{/canloginbyemail}}
                    </label>
                    <div class="rm-login-field">
                        <i class="fa fa-user rm-login-field-icon" aria-hidden="true"></i>
                        <input type="text" name="username" id="username" {{!
                            !}}class="form-control form-control-lg" {{!
                            !}}value="{{username}}" {{!
                            !}}placeholder="{{^canloginbyemail}}{{#cleanstr}}username{{/cleanstr}}{{/canloginbyemail}}{{!
                            !}}{{#canloginbyemail}}{{#cleanstr}}usernameemail{{/cleanstr}}{{/canloginbyemail}}" {{!
                            !}}autocomplete="username">
                    </div>
                </div>
                <div class="login-form-password mb-3">
                    <div class="rm-login-label-row">
                        <label for="password" class="richimath-field-label">{{#str}} password {{/str}}</label>
                        <a class="rm-login-forgot" href="{{forgotpasswordurl}}">{{#str}} forgotaccount {{/str}}</a>
                    </div>
                    <div class="rm-login-field">
                        <i class="fa fa-lock rm-login-field-icon" aria-hidden="true"></i>
                        <input type="password" name="password" id="password" value="" {{!
                            !}}class="form-control form-control-lg" {{!
                            !}}placeholder="{{#cleanstr}}password{{/cleanstr}}" {{!
                            !}}autocomplete="current-password">
                        {{! Shown when core's "toggle password" setting is on, so the
                            admin still decides; our button only replaces its look. }}
                        {{#togglepassword}}
                        <button type="button" class="rm-login-reveal" id="richimath-reveal" {{!
                            !}}aria-controls="password" aria-pressed="false" {{!
                            !}}data-show="{{#cleanstr}} loginshowpassword, theme_richimath {{/cleanstr}}" {{!
                            !}}data-hide="{{#cleanstr}} loginhidepassword, theme_richimath {{/cleanstr}}" {{!
                            !}}aria-label="{{#cleanstr}} loginshowpassword, theme_richimath {{/cleanstr}}">
                            <i class="fa fa-eye" aria-hidden="true"></i>
                        </button>
                        {{/togglepassword}}
                    </div>
                </div>
                {{#recaptcha}}
                    <div class="login-form-recaptcha mb-3">
                        {{{recaptcha}}}
                    </div>
                {{/recaptcha}}
                <div class="login-form-submit mb-3">
                    <button class="btn btn-primary btn-lg" type="submit" id="loginbtn">
                        {{#str}}login{{/str}}<i class="fa fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>
            </form>
            {{/showloginform}}

            {{#hasidentityproviders}}
                <div class="rm-login-divider"><span>{{#str}} potentialidps, auth {{/str}}</span></div>
                <div class="login-identityproviders rm-login-idps">
                    {{#identityproviders}}
                        <a class="btn login-identityprovider-btn" href="{{url}}">
                            {{#iconurl}}
                                <img src="{{iconurl}}" alt="" width="24" height="24"/>
                            {{/iconurl}}
                            {{name}}
                        </a>
                    {{/identityproviders}}
                </div>
            {{/hasidentityproviders}}

            {{#hasauthinstructions}}
                <div class="login-instructions">
                    <h3 class="rm-login-subheading">{{#str}}firsttime{{/str}}</h3>
                    {{{instructions}}}
                </div>
            {{/hasauthinstructions}}

            {{#canloginasguest}}
                <form action="{{loginurl}}" method="post" id="guestlogin" class="rm-login-guest">
                    <input type="hidden" name="logintoken" value="{{logintoken}}">
                    <input type="hidden" name="username" value="guest" />
                    <input type="hidden" name="password" value="guest" />
                    <button class="btn btn-secondary" type="submit" id="loginguestbtn">
                        <i class="fa fa-right-to-bracket" aria-hidden="true"></i>{{#str}}loginguest{{/str}}
                    </button>
                </form>
            {{/canloginasguest}}

            {{#cansignup}}
                <p class="rm-login-signup">
                    {{#str}} firsttime {{/str}}
                    <a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
                </p>
            {{/cansignup}}

            <div class="rm-login-note">
                <i class="fa fa-circle-info" aria-hidden="true"></i>
                <button type="button" class="btn btn-link" {{!
                }} data-modal="alert"{{!
                }} data-modal-title-str='["cookiesenabled", "core"]' {{!
                }} data-modal-content-str='["cookiesenabled_help_html", "core"]'{{!
                }}>{{#str}}cookiesnotice{{/str}}</button>
            </div>
        </section>
    </div>

    <footer class="rm-login-legal">
        <span>{{{sitename}}}</span>
        <span class="rm-login-mono">{{#str}} logincredits, theme_richimath {{/str}}</span>
    </footer>
</div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                if (errorMessage) {
                    errorMessageDiv.innerHTML += "&nbsp;";
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += "&nbsp;";
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    var revealBtn = document.getElementById('richimath-reveal');
    if (revealBtn) {
        var pwd = document.getElementById('password');
        revealBtn.addEventListener('click', function() {
            var shown = pwd.type === 'text';
            pwd.type = shown ? 'password' : 'text';
            revealBtn.setAttribute('aria-pressed', shown ? 'false' : 'true');
            revealBtn.setAttribute('aria-label', shown ? revealBtn.dataset.show : revealBtn.dataset.hide);
            revealBtn.firstElementChild.className = shown ? 'fa fa-eye' : 'fa fa-eye-slash';
        });
    }
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
        {{#canloginasguest}}
            Submit.init("loginguestbtn");
        {{/canloginasguest}}
    });
{{/js}}

