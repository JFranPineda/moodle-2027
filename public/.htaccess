# BEGIN richimath routes (generated by scripts/build-routes.php)
# Edit local/richimath/routes.php and run scripts/build-routes.php.
<IfModule mod_dir.c>
    # /login is a real directory, and mod_dir would 301 it to
    # /login/ before the rules below ever serve it.
    DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Real path -> pretty address, for requests that came from a browser.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^local\/richimath\/students\.php$ /students [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^local\/richimath\/accept\.php$ /join [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^local\/richimath\/invite\.php$ /invitations [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^local\/richimath\/plans\.php$ /plans [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^local\/richimath\/userplans\.php$ /members [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^login\/index\.php$ /login [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^login\/$ /login [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^login\/signup\.php$ /signup [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^login\/forgot_password\.php$ /recover [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^my\/index\.php$ /dashboard [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^my\/$ /dashboard [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^course\/index\.php$ /courses [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^course\/$ /courses [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^calendar\/view\.php$ /calendar [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^grade\/report\/overview\/index\.php$ /grades [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^message\/index\.php$ /messages [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^message\/$ /messages [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^user\/profile\.php$ /profile [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^user\/preferences\.php$ /preferences [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^my\/courses\.php$ /mycourses [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^message\/output\/popup\/notifications\.php$ /notifications [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^search\/index\.php$ /search [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^admin\/search\.php$ /admin [R=302,L,QSA]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteRule ^login\/logout\.php$ /logout [R=302,L,QSA]

    # 2. Pretty address -> the script that serves it, in place.
    RewriteRule ^students/?$ local/richimath/students.php [L,QSA]
    RewriteRule ^join/?$ local/richimath/accept.php [L,QSA]
    RewriteRule ^invitations/?$ local/richimath/invite.php [L,QSA]
    RewriteRule ^plans/?$ local/richimath/plans.php [L,QSA]
    RewriteRule ^members/?$ local/richimath/userplans.php [L,QSA]
    RewriteRule ^login/?$ login/index.php [L,QSA]
    RewriteRule ^signup/?$ login/signup.php [L,QSA]
    RewriteRule ^recover/?$ login/forgot_password.php [L,QSA]
    RewriteRule ^dashboard/?$ my/index.php [L,QSA]
    RewriteRule ^courses/?$ course/index.php [L,QSA]
    RewriteRule ^calendar/?$ calendar/view.php [L,QSA]
    RewriteRule ^grades/?$ grade/report/overview/index.php [L,QSA]
    RewriteRule ^messages/?$ message/index.php [L,QSA]
    RewriteRule ^profile/?$ user/profile.php [L,QSA]
    RewriteRule ^preferences/?$ user/preferences.php [L,QSA]
    RewriteRule ^mycourses/?$ my/courses.php [L,QSA]
    RewriteRule ^notifications/?$ message/output/popup/notifications.php [L,QSA]
    RewriteRule ^search/?$ search/index.php [L,QSA]
    RewriteRule ^admin/?$ admin/search.php [L,QSA]
    RewriteRule ^logout/?$ login/logout.php [L,QSA]

    # 3. Moodle router: anything that is neither a file nor a directory.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /r.php [L]
</IfModule>
# END richimath routes
